{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "content": "bun run scripts/content.ts",
    "content:check": "bun run scripts/content.ts --check",
    "content:watch": "bun run scripts/content.ts --watch",
    "build": "bun run scripts/build.ts",
    "build:pages": "bun run scripts/build.ts --base /self-web",
    "preview": "bun run scripts/preview.ts",
    "verify:pages": "bun run scripts/inspect-bundle.ts /self-web",
    "smoke": "bun run scripts/smoke.ts",
    "typecheck": "bun run scripts/content.ts && tsc --noEmit",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.2"
  }
}
